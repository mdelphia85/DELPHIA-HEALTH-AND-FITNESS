<FreeTrainingScreen>:
    name: "freetraining"

    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)

        # Input fields
        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(20)
            size_hint_y: None
            height: self.minimum_height
            pos_hint: {"center_x": 0.5}

            MDTextField:
                id: workout_name
                hint_text: "Workout Name"
                text_color: 1, 0.84, 0, 1
                foreground_color: 1, 0.84, 0, 1
                cursor_color: 1, 0.84, 0, 1
                hint_text_color: 1, 0.84, 0, 0.7
                background_color: 0, 0, 0, 1
                canvas.before:
                    Color:
                        rgba: 1, 0.84, 0, 1
                    Line:
                        width: 1.8
                        rectangle: (self.x, self.y, self.width, self.height)

            MDTextField:
                id: skill_focus
                hint_text: "Skill Focus"
                text_color: 1, 0.84, 0, 1
                foreground_color: 1, 0.84, 0, 1
                cursor_color: 1, 0.84, 0, 1
                hint_text_color: 1, 0.84, 0, 0.7
                background_color: 0, 0, 0, 1
                canvas.before:
                    Color:
                        rgba: 1, 0.84, 0, 1
                    Line:
                        width: 1.8
                        rectangle: (self.x, self.y, self.width, self.height)

            MDTextField:
                id: notes
                hint_text: "Notes"
                text_color: 1, 0.84, 0, 1
                foreground_color: 1, 0.84, 0, 1
                cursor_color: 1, 0.84, 0, 1
                hint_text_color: 1, 0.84, 0, 0.7
                background_color: 0, 0, 0, 1
                canvas.before:
                    Color:
                        rgba: 1, 0.84, 0, 1
                    Line:
                        width: 1.8
                        rectangle: (self.x, self.y, self.width, self.height)

        # Timer
        MDLabel:
            id: timer_label
            text: "00:00:00"
            font_style: "Headline"
            halign: "center"
            theme_text_color: "Custom"
            text_color: 1, 0.84, 0, 1

        # Start/Stop buttons
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(40)
            spacing: dp(20)
            pos_hint: {"center_x": 0.5}

            MenuLabel:
                id: start_timer
                text: "[u]Start Timer[/u]"
                markup: True
                theme_text_color: "Custom"
                text_color: 1, 0.84, 0, 1
                on_release: root.start_timer()

            MenuLabel:
                id: stop_timer
                text: "[u]Stop Timer[/u]"
                markup: True
                theme_text_color: "Custom"
                text_color: 1, 0.84, 0, 1
                on_release: root.stop_timer()

        # Save Session bottom-left
        AnchorLayout:
            anchor_x: "left"
            anchor_y: "bottom"
            size_hint: None, None
            size: dp(160), dp(48)

            MenuLabel:
                id: save_session
                text: "[u]Save Session[/u]"
                markup: True
                theme_text_color: "Custom"
                text_color: 1, 0.84, 0, 1
                on_release: root.save_session()

        # --- Footer: Return to Menu ---
        AnchorLayout:
            anchor_x: "right"
            anchor_y: "bottom"
            size_hint: None, None
            size: dp(160), dp(48)
            pos_hint: {"right": 1, "y": 0}

            MDLabel:
                text: "[u]Return to Menu[/u]"
                markup: True
                theme_text_color: "Custom"
                text_color: 1, 0.84, 0, 1
                halign: "right"
                valign: "middle"
                on_touch_down:
                    if self.collide_point(*args[1].pos): app.return_to_menu_dropdown() if hasattr(app, "return_to_menu_dropdown") else None
